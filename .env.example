APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=apprentice_cursus
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local (Sail): mails land in Mailpit, http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"




MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

MICROSOFT_REDIRECT_URI=http://localhost/auth/microsoft/callback
MICROSOFT_ACCOUNT_CHECK_INTERVAL=900
MICROSOFT_GROUP_APPRENTICES_IT=
MICROSOFT_GROUP_APPRENTICES_EC=
MICROSOFT_GROUP_TRAINER_IT=
MICROSOFT_GROUP_TRAINER_EC=
MICROSOFT_GROUP_COACH=


GEMINI_API_KEY=
TYPESAFE_API_KEY=
# OCR is on by default; set to false to hide it and 404 the read-scan route
OCR_ENABLED=true

# Grade intake mailbox read by `emails:fetch`. IMAP_USERNAME is also the address that
# receives the "grades received" summary mails.
# Local (Sail): the GreenMail test server, no real credentials needed.
# Production: e.g. IMAP_HOST=imap.gmail.com, IMAP_PORT=993, IMAP_ENCRYPTION=ssl,
# IMAP_VALIDATE_CERT=true and the real mailbox credentials.
IMAP_DEFAULT_ACCOUNT=default
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=false
IMAP_VALIDATE_CERT=false
IMAP_USERNAME=grades@example.com
IMAP_PASSWORD=password
IMAP_AUTHENTICATION=
IMAP_TRUSTED_AUTHSERV_ID=
