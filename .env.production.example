# Paste into the Komodo stack's Environment. Never commit real values.
APP_NAME="Apprentice Cursus"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=https://your-domain
APP_PORT=8080
# Image Komodo's Build pushes, e.g. ghcr.io/<org>/apprentice-cursus:latest
APP_IMAGE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=apprentice_cursus
DB_USERNAME=apprentice_cursus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://your-domain/auth/microsoft/callback
MICROSOFT_ACCOUNT_CHECK_INTERVAL=900
MICROSOFT_GROUP_APPRENTICES_IT=
MICROSOFT_GROUP_APPRENTICES_EC=
MICROSOFT_GROUP_TRAINER_IT=
MICROSOFT_GROUP_TRAINER_EC=
MICROSOFT_GROUP_COACH=

GEMINI_API_KEY=
TYPESAFE_API_KEY=
OCR_ENABLED=true
