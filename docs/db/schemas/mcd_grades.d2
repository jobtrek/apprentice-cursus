grades: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  user_id: bigint {constraint: foreign_key} # Reference users
  domain_id: bigint {constraint: foreign_key}
  value: "decimal(2,1)" # CHECK (value BETWEEN 1.0 AND 6.0)
  test_date: date
  file_path: varchar
  notified_at: timestamp
  created_at: timestamp
  updated_at: timestamp
}

domains: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  name: varchar
  rounding_step: "decimal(2,1)"
}

domain_links: {
  shape: sql_table
  parent_id: bigint {constraint: [PK; FK]}
  child_id: bigint {constraint: [PK; FK]}
  is_mpi: boolean {constrain: PK}
  weight: "decimal(3, 2)"
  # UNIQUE (parent_id, child_id. is_mpi)
  # CHECK (parent_id <> child_id)
}

domain_links -> domains: child relationship {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

domain_links -> domains: parent relationship {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

grades -> domains: belong to {
  source-arrowhead: {shape: cf-many}
  target-arrowhead: {shape: cf-one-required}
}
