direction: right

apprenticeships: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  name: varchar
  created_at: timestamp
  updated_at: timestamp
}

users: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  azure_id: varchar {constraint: unique}
  tenant_id: varchar
  apprenticeship_id: {constraint: foreign_key}
  name: varchar
  email: varchar {constraint: unique}
  email_verified_at: timestamp
  password: varchar
  is_active: boolean
  is_mpi: boolean
  synced_at: timestamp
  coach_id: bigint {constraint: foreign_key}
  trainer_id: bigint {constraint: foreign_key}
}

comments: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  author_id: bigint {constraint: foreign_key}
  commentable_type: varchar
  commentable_id: bigint
  body: text
  created_at: timestamp
  updated_at: timestamp
}

apprenticeships -> users: apprentices {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

users -> grades: user-grade {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

users -> users: coach {
  source-arrowhead: {shape: cf-one}
  target-arrowhead: {shape: cf-many}
}

users -> users: trainer {
  source-arrowhead: {shape: cf-one}
  target-arrowhead: {shape: cf-many}
}

users -> projects: apprentice {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

projects: {
  label: Projects

  ...@mcd_projects
}

grades: {
    label: Grades

    ...@mcd_grades
}

users -> comments: author {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

grades -> comments: commentable {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

projects -> comments: commentable {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

"""
spatie: {
