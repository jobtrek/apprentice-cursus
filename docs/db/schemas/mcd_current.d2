direction: right
vars: {
  d2-config: {
    layout-engine: tala
  }
}

formation_plans: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  name: varchar
}

users: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  azure_id: varchar {constraint: unique}
  tenant_id: varchar
  formation_plan_id: bigint {constraint: [foreign_key; nullable]}
  name: varchar
  email: varchar {constraint: unique}
  email_verified_at: timestamp
  password: varchar
  is_active: boolean
  synced_at: timestamp
  coach_id: bigint {constraint: foreign_key}
}

formation_plans -> users: a plan that is trained {
  source-arrowhead: {shape: cf-one}
  target-arrowhead: {shape: cf-many}
}

average_node_formation_plan: {
  shape: sql_table
  formation_plan_id: bigint {constraint: [primary_key; foreign_key]} # Reference the formation plan that uses the node.
  average_node_id: bigint {constraint: [primary_key; foreign_key]} # Reference an average node that is part of that plan. Composite primary key: the same pair can only exist once.
}

formation_plans -> average_node_formation_plan: a plan that uses nodes {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

grades.average_nodes -> average_node_formation_plan: plan root nodes {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

 comments: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  author_id: bigint {constraint: foreign_key}
  project_id: bigint {constraint: [foreign_key; nullable]}
  grade_id: bigint {constraint: [foreign_key; nullable]}
  body: text
  created_at: timestamp
  updated_at: timestamp
}



users -> grades.grades: user-grade {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

users.coach_id -> users.id: coach {
  source-arrowhead: {shape: cf-many}
  target-arrowhead: {shape: cf-one}
}

projects: {
  label: Projects

  ...@mcd_projects
}

users -> projects.projects: apprentice {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

grades: {
  label: Grades

  ...@mcd_grades
}

users -> comments: author {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

grades.grades -> comments: commentable {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

projects.projects -> comments: commentable {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

"""
spatie: {
  label: Spatie

  ...@mcd_roles
}

users -> spatie.model_has_roles: model {
  style.stroke-dash: 3
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

users -> spatie.model_has_permissions: model {
  style.stroke-dash: 3
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}
"""
