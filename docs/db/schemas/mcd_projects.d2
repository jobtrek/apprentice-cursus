projects: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  user_id: bigint {constraint: foreign_key}
  title: varchar
  organization: varchar
  description: text
  responsibilities: varchar
  technologies: varchar
  repository_url: varchar
  demo_url: varchar
  date_start: date
  date_end: date
}

project_screenshots: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  project_id: bigint {constraint: foreign_key}
  path: varchar
}

skills: {
  shape: sql_table
  id: bigint {constraint: primary_key}
  name: varchar {constraint: unique}
}

project_skill: {
  shape: sql_table
  project_id: bigint {constraint: [primary_key; foreign_key]}
  skill_id: bigint {constraint: [primary_key; foreign_key]}
}

projects -> project_screenshots: screenshots {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

projects -> project_skill: projects {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}

skills -> project_skill: skills {
  source-arrowhead: {shape: cf-one-required}
  target-arrowhead: {shape: cf-many}
}
